{
  "name": "BehindTheWalls",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "ReplicaClient": {
        "$path": "src/vendor/Replica/ReplicaClient.luau"
      },
      "ReplicaShared": {
        "$path": "src/vendor/Replica/ReplicaShared"
      },
      "Blink": {
        "$path": "src/shared/Blink"
      },
      "Shared": {
        "$className": "Folder",
        "Modules": {
          "$path": "src/shared/Modules"
        }
      }
    },

    "ReplicatedFirst": {
      "Loading_Handler": {
        "$path": "src/replicatedFirst/Loading_Handler"
      }
    },

    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "ReplicaServer": {
        "$path": "src/vendor/Replica/ReplicaServer.luau"
      },
      "Server": {
        "$className": "Folder",
        "Bootstrap": {
          "$path": "src/server/Bootstrap.server.luau"
        },
        "Systems": {
          "$className": "Folder",
          "$path": "src/server/Systems"
        },
        "Modules": {
          "$className": "Folder",
          "$path": "src/server/Modules"
        }
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "MenuPanels": {
        "$path": "src/client/Gui/MenuPanels.model.json"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$className": "Folder",
          "Bootstrap": {
            "$path": "src/client/Bootstrap.client.luau"
          },
          "Controllers": {
            "$className": "Folder",
            "$path": "src/client/Controllers"
          },
          "Modules": {
            "$className": "Folder",
            "$path": "src/client/Modules"
          }
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true
    }
  }
}
